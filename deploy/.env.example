# Shared numeric identity for PHP writer + agent (must match).
SPOOL_UID=33
SPOOL_GID=33

TRACEWICK_PYROSCOPE_URL=http://host.docker.internal:4040
# TRACEWICK_PYROSCOPE_USER=
# TRACEWICK_PYROSCOPE_PASSWORD=
# TRACEWICK_PYROSCOPE_TENANT=
# TRACEWICK_METRICS_LISTEN=0.0.0.0:9090

# Compose forwards these into the agent process; the binary does not read this file.
# TRACEWICK_TLS_CA=/etc/ssl/extra-ca.pem
# TRACEWICK_READER_ID=compose-agent
# TRACEWICK_AGGREGATION_WINDOW=15
# TRACEWICK_SLEEP=5s
# TRACEWICK_SHUTDOWN_GRACE=30s
# TRACEWICK_MAX_REJECTED_FILES=100
# TRACEWICK_MAX_STACKS=4096
# TRACEWICK_MAX_FRAMES=16384
# TRACEWICK_MAX_STRINGS=32768
# TRACEWICK_MAX_HELD_DECODED_BYTES=67108864
# TRACEWICK_MAX_IN_FLIGHT_BYTES=67108864
